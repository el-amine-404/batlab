# systemd *user* unit for the rootless Dangerzone account. Dangerzone launches
# its sandbox with --cgroups=disabled, so these limits contain the sandbox too.
[Unit]
Description=PDF gateway Dangerzone CDR provider
After=default.target

[Service]
Type=simple
Environment=CONTAINERS_CONF=/etc/batlab/pdf-cdr/containers.conf
EnvironmentFile=%h/.config/pdf-cdr-provider/provider.env
ExecStart=/usr/bin/python3 -I %h/.local/lib/pdf-cdr-provider/provider.py --socket ${PDF_CDR_SOCKET} --allowed-uid ${PDF_CDR_ALLOWED_UID} --scratch %t/pdf-cdr-provider --timeout ${PDF_CDR_TIMEOUT_SECONDS}
Restart=on-failure
RestartSec=10
# Exit 3 means a sandbox survived termination; stay down until an operator looks.
RestartPreventExitStatus=3
Nice=10
IOSchedulingClass=idle
# One core: Lab2 health outranks conversion speed (88 °C peak at 200%, 2026-10-25).
CPUQuota=100%
MemoryMax=3G
MemorySwapMax=0
TasksMax=256

[Install]
WantedBy=default.target
