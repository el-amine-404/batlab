# Capacity limits for lab2: Fujitsu LIFEBOOK U748, Intel i5-8350U (4 cores, 8
# threads), 31 GB RAM. Starting values from docs/migration-lab2.md: lab1's
# limits, with Ollama and Immich raised. Adjust after a week of Netdata.

OLLAMA_CPUS=6
OLLAMA_MEM_LIMIT=12gb
OLLAMA_MEM_RESERVATION=1gb
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

CLEANUPARR_CPUS=0.5
CLEANUPARR_MEM_LIMIT=512mb
CLEANUPARR_MEM_RESERVATION=128mb

DISPATCHARR_CPUS=2
DISPATCHARR_MEM_LIMIT=4gb
DISPATCHARR_MEM_RESERVATION=512mb

NODECAST_CPUS=2
NODECAST_MEM_LIMIT=2gb
NODECAST_MEM_RESERVATION=256mb

HOMEPAGE_CPUS=0.8
HOMEPAGE_MEM_LIMIT=1gb
HOMEPAGE_MEM_RESERVATION=500m

IMMICH_SERVER_MEM_LIMIT=4gb
IMMICH_SERVER_MEM_RESERVATION=1gb

IMMICH_ML_MEM_LIMIT=4gb
IMMICH_ML_MEM_RESERVATION=512mb

IMMICH_REDIS_MEM_LIMIT=256mb
IMMICH_REDIS_MEM_RESERVATION=64mb

IMMICH_DB_MEM_LIMIT=2gb
IMMICH_DB_MEM_RESERVATION=512mb

NETDATA_CPUS=1.5
NETDATA_MEM_LIMIT=1gb
NETDATA_MEM_RESERVATION=512m

PAPERLESS_DB_CPUS=0.5
PAPERLESS_DB_MEM_LIMIT=512mb
PAPERLESS_DB_MEM_RESERVATION=128mb

PAPERLESS_REDIS_CPUS=0.25
PAPERLESS_REDIS_MEM_LIMIT=256mb
PAPERLESS_REDIS_MEM_RESERVATION=64mb

SEERR_CPUS=0.5
SEERR_MEM_LIMIT=1gb
SEERR_MEM_RESERVATION=256mb

# Frigate: live view of 2 cameras and person detection on the rooftop, decoding
# and detection on the iGPU. ~1.2 GB in use at rest; the recording cache
# (/tmp/cache, RAM) counts against the limit too.
FRIGATE_CPUS=2
FRIGATE_MEM_LIMIT=3gb
FRIGATE_MEM_RESERVATION=1gb

# The OpenVINO model plus concurrent recording and clip ffmpeg processes
# reached the old 768 MB cgroup limit 11 times on 2026-10-18 and 19.
CARWATCH_MEM_LIMIT=1536m

# Jellyfin and Frigate hardware decoding: gid of the host's render group
# (getent group render | cut -d: -f3).
RENDER_GID=992

# NetAlertX scans this subnet through this interface (arp-scan needs it
# named: Docker's bridges would otherwise be picked).
NETALERTX_SUBNET=192.168.1.0/24
NETALERTX_INTERFACE=enp0s31f6

# The TV web remote looks for Samsung TVs in this subnet.
TV_REMOTE_SUBNET=192.168.1.0/24

# pdf-gateway: a background workload that must not heat the laptop (it reached
# 95 °C under uncapped tests). With the host CDR provider's 1-core quota the
# whole pipeline stays near 4 cores at worst; idle it is near zero.
PDF_GATEWAY_CORE_CPUS=0.25
PDF_GATEWAY_API_CPUS=0.5
PDF_GATEWAY_CLAMAV_CPUS=0.5
PDF_GATEWAY_WORKER_CPUS=0.5

# scanloom: idle API/web are tiny; one image worker is deliberately bounded so
# phone-camera batches do not overheat lab2. ClamAV definitions dominate memory.
SCANLOOM_DB_MEM_LIMIT=512m
SCANLOOM_DB_CPUS=0.25
SCANLOOM_CLAMAV_MEM_LIMIT=3g
SCANLOOM_CLAMAV_CPUS=0.4
SCANLOOM_API_MEM_LIMIT=512m
SCANLOOM_API_CPUS=0.4
SCANLOOM_WORKER_MEM_LIMIT=2g
SCANLOOM_WORKER_CPUS=1.0
SCANLOOM_WEB_MEM_LIMIT=96m
SCANLOOM_WEB_CPUS=0.2
