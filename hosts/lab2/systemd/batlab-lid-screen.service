[Unit]
Description=Blank lab2's built-in screen while its lid is closed
Documentation=file:/home/potato/batlab/hosts/lab2/README.md
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/batlab-lid-screen
ExecStop=/usr/local/libexec/batlab-lid-screen --restore
Restart=on-failure
RestartSec=2s
RuntimeDirectory=batlab-lid-screen
RuntimeDirectoryPreserve=yes
User=root
Group=root
NoNewPrivileges=yes
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
PrivateTmp=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
