[Unit]
Description=Answer on lab1's address 192.168.1.3 while lab1 is off
# Every DHCP lease lists 192.168.1.3 as the first DNS server. Some clients (the
# Samsung TV's video player) never fall back to the second, so with lab1 off they
# cannot resolve anything. lab2's AdGuard listens on 0.0.0.0 and answers there.
#
# Turn OFF before lab1 is powered on, or both hosts claim the address:
#   sudo systemctl disable --now batlab-lab1-standin
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Refuse when something already answers on the address: lab1 is back.
ExecStartPre=/bin/sh -c '! ping -c 2 -W 1 192.168.1.3 >/dev/null'
ExecStart=/usr/sbin/ip addr add 192.168.1.3/24 dev enp0s31f6
ExecStop=/usr/sbin/ip addr del 192.168.1.3/24 dev enp0s31f6

[Install]
WantedBy=multi-user.target
