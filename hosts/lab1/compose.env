# Capacity limits for lab1: AMD A8-4500M (4 cores, 2012), 15 GB RAM, no battery.
# Loaded by the Makefile after compose/.env. Every value here was sized for this
# machine; see README.md in this directory before copying it to another host.

OLLAMA_CPUS=3.5
OLLAMA_MEM_LIMIT=8gb
OLLAMA_MEM_RESERVATION=1gb
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

CLEANUPARR_CPUS=0.5
CLEANUPARR_MEM_LIMIT=512mb
CLEANUPARR_MEM_RESERVATION=128mb

HOMEPAGE_CPUS=0.8
HOMEPAGE_MEM_LIMIT=1gb
HOMEPAGE_MEM_RESERVATION=500m

IMMICH_SERVER_MEM_LIMIT=4gb
IMMICH_SERVER_MEM_RESERVATION=1gb

IMMICH_ML_MEM_LIMIT=3gb
IMMICH_ML_MEM_RESERVATION=512mb

IMMICH_REDIS_MEM_LIMIT=256mb
IMMICH_REDIS_MEM_RESERVATION=64mb

IMMICH_DB_MEM_LIMIT=2gb
IMMICH_DB_MEM_RESERVATION=512mb

NETDATA_CPUS=1.5
NETDATA_MEM_LIMIT=1gb
NETDATA_MEM_RESERVATION=512m

PAPERLESS_DB_CPUS=0.5
PAPERLESS_DB_MEM_LIMIT=512mb
PAPERLESS_DB_MEM_RESERVATION=128mb

PAPERLESS_REDIS_CPUS=0.25
PAPERLESS_REDIS_MEM_LIMIT=256mb
PAPERLESS_REDIS_MEM_RESERVATION=64mb

SEERR_CPUS=0.5
SEERR_MEM_LIMIT=1gb
SEERR_MEM_RESERVATION=256mb
