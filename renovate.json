{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "docker-compose",
    "npm",
    "maven",
    "pip_requirements",
    "pip-compile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "IMAGE_X / TAG_X pairs in compose/versions.env",
      "managerFilePatterns": [
        "/^compose/versions\\.env$/"
      ],
      "matchStrings": [
        "IMAGE_[A-Z0-9_]+=(?<depName>[^\\s]+)\\nTAG_[A-Z0-9_]+=(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "PYPI_X / VERSION_X pairs in compose/versions.env: Python packages a local image installs",
      "managerFilePatterns": [
        "/^compose/versions\\.env$/"
      ],
      "matchStrings": [
        "PYPI_[A-Z0-9_]+=(?<depName>[^\\s]+)\\nVERSION_[A-Z0-9_]+=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "CRATE_X / VERSION_X pairs in compose/versions.env: Rust crates a local image compiles",
      "managerFilePatterns": [
        "/^compose/versions\\.env$/"
      ],
      "matchStrings": [
        "CRATE_[A-Z0-9_]+=(?<depName>[^\\s]+)\\nVERSION_[A-Z0-9_]+=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "description": "The pdfid and pdf-parser commit the gateway's analysis image pins",
      "managerFilePatterns": [
        "/^compose/pdf-gateway/app/analysis-worker/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DIDIER_STEVENS_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "master",
      "depNameTemplate": "https://github.com/DidierStevens/DidierStevensSuite.git",
      "datasourceTemplate": "git-refs"
    }
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore:",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Dockerfiles, npm, Maven, pip and Compose files are read only for the apps built here. Other services stay on versions.env",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "npm",
        "maven",
        "pip_requirements",
        "pip-compile"
      ],
      "matchFileNames": [
        "!compose/{pdf-gateway,scanloom,clipseerr,subfeed,videodrop,songdrop,stanzarr,musicguard,tv-remote,nodecast,untrunc,speed_test}/**"
      ],
      "enabled": false
    },
    {
      "description": "Commit and PR titles: the exact tag written to versions.env, no added v prefix; placed in a rule so it overrides the docker preset",
      "matchDatasources": [
        "docker"
      ],
      "commitMessageAction": "update",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newValue}}"
    },
    {
      "description": "ghcr.io and lscr.io publish no release timestamps, and minimumReleaseAge otherwise holds their updates back forever; the nightly updater's health check and rollback stay the safety net",
      "matchPackageNames": [
        "ghcr.io/**",
        "lscr.io/**"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "linuxserver.io tags carry a build suffix (-lsNNN) and, for qBittorrent, the libtorrent version",
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:_v\\d+\\.\\d+\\.\\d+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Jellyfin moved to two-part tags (12.0) beside timestamped builds and date-named nightlies; accept only X.Y or X.Y.Z releases",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "versioning": "regex:^(?<major>\\d{1,3})\\.(?<minor>\\d{1,3})(?:\\.(?<patch>\\d{1,3}))?$"
    },
    {
      "description": "Readarr only publishes nightly tags and the project is retired",
      "matchPackageNames": [
        "lscr.io/linuxserver/readarr"
      ],
      "enabled": false
    },
    {
      "description": "Every other minor and patch update arrives as one weekly commit, merged by itself; the nightly updater deploys those in auto-services.txt, with health check and rollback",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!ghcr.io/gethomepage/homepage",
        "!jellyfin/jellyfin",
        "!ghcr.io/seerr-team/seerr",
        "!lscr.io/linuxserver/sonarr",
        "!lscr.io/linuxserver/radarr",
        "!lscr.io/linuxserver/prowlarr",
        "!lscr.io/linuxserver/lidarr",
        "!lscr.io/linuxserver/bazarr",
        "!lscr.io/linuxserver/qbittorrent",
        "!ghcr.io/cleanuparr/cleanuparr",
        "!ghcr.io/recyclarr/recyclarr",
        "!ghcr.io/flaresolverr/flaresolverr",
        "!deluan/navidrome",
        "!filebrowser/filebrowser",
        "!louislam/uptime-kuma",
        "!amir20/dozzle",
        "!ghcr.io/netalertx/netalertx",
        "!ghcr.io/dmunozv04/isponsorblocktv",
        "!spotdl/spotify-downloader",
        "!yt-dlp",
        "!python",
        "!rust",
        "!node",
        "!ytmusicapi",
        "!songrec",
        "!denoland/deno",
        "!ghcr.io/technomancer702/nodecast-tv"
      ],
      "groupName": "weekly minor and patch updates",
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "DNS, proxy, VPN, databases and apps whose upgrades migrate data: minor and patch updates wait in one weekly PR",
      "matchPackageNames": [
        "adguard/adguardhome",
        "mvance/unbound",
        "caddy",
        "qmcgaw/gluetun",
        "postgres",
        "rabbitmq",
        "ghcr.io/immich-app/**",
        "docker.io/valkey/valkey",
        "ghcr.io/blakeblackshear/frigate",
        "eclipse-mosquitto",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "docker.io/apache/tika"
      ],
      "matchFileNames": [
        "compose/versions.env"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false,
      "groupName": "infrastructure minor and patch updates",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Low-risk, security-relevant apps: minor and patch updates merge straight into main without a PR; lab1's updater deploys them, and its health check and rollback are the test, since the repository has no CI",
      "matchPackageNames": [
        "ghcr.io/gethomepage/homepage",
        "jellyfin/jellyfin",
        "ghcr.io/seerr-team/seerr",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/lidarr",
        "lscr.io/linuxserver/bazarr",
        "lscr.io/linuxserver/qbittorrent",
        "ghcr.io/cleanuparr/cleanuparr",
        "ghcr.io/recyclarr/recyclarr",
        "ghcr.io/flaresolverr/flaresolverr",
        "deluan/navidrome",
        "filebrowser/filebrowser",
        "louislam/uptime-kuma",
        "amir20/dozzle",
        "ghcr.io/netalertx/netalertx",
        "ghcr.io/dmunozv04/isponsorblocktv",
        "spotdl/spotify-downloader",
        "yt-dlp"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Major updates always need a human, whatever the image",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "description": "Compose files are only read for Scanloom, the one app that pins its images there",
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "!compose/scanloom/**"
      ],
      "enabled": false
    },
    {
      "description": "pip_requirements can't regenerate hashes, pip-compile does; it keeps only the gateway's sandbox, which has no lock file",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "!compose/pdf-gateway/app/shapes-sandbox/**"
      ],
      "enabled": false
    },
    {
      "description": "Everything the apps built here are made of merges by itself, majors included, once deps-gate has built the app and run its tests. The updater then rebuilds and deploys it, with health check and rollback",
      "matchFileNames": [
        "compose/{pdf-gateway,scanloom,clipseerr,subfeed,videodrop,songdrop,stanzarr,musicguard,tv-remote,nodecast,untrunc,speed_test}/**"
      ],
      "minimumReleaseAge": "1 day",
      "schedule": [
        "at any time"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": false
    },
    {
      "description": "The same for what they take from versions.env: Python, Node, Rust, Deno, their libraries and Nodecast's base",
      "matchPackageNames": [
        "python",
        "node",
        "rust",
        "denoland/deno",
        "ytmusicapi",
        "songrec",
        "ghcr.io/technomancer702/nodecast-tv"
      ],
      "minimumReleaseAge": "1 day",
      "schedule": [
        "at any time"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": false
    },
    {
      "description": "pdf-gateway: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/pdf-gateway/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "pdf-gateway dependencies"
    },
    {
      "description": "scanloom: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/scanloom/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "scanloom dependencies"
    },
    {
      "description": "clipseerr: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/clipseerr/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "clipseerr dependencies"
    },
    {
      "description": "subfeed: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/subfeed/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "subfeed dependencies"
    },
    {
      "description": "videodrop: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/videodrop/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "videodrop dependencies"
    },
    {
      "description": "songdrop: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/songdrop/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "songdrop dependencies"
    },
    {
      "description": "stanzarr: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/stanzarr/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "stanzarr dependencies"
    },
    {
      "description": "musicguard: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/musicguard/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "musicguard dependencies"
    },
    {
      "description": "tv-remote: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/tv-remote/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "tv-remote dependencies"
    },
    {
      "description": "nodecast: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/nodecast/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "nodecast dependencies"
    },
    {
      "description": "untrunc: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/untrunc/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "untrunc dependencies"
    },
    {
      "description": "speed_test: minor and patch updates share a branch, so a broken one in another app holds nothing up; each major keeps its own",
      "matchFileNames": [
        "compose/speed_test/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "speed_test dependencies"
    },
    {
      "description": "The weekly lock file refresh brings the indirect dependencies up to date, through the same gate",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": false
    },
    {
      "description": "yt-dlp numbers releases by date (2026.10.09), so January's first release looks like a major; merge those too",
      "matchPackageNames": [
        "yt-dlp"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "labels": [
        "dependencies"
      ]
    },
    {
      "description": "yt-dlp: a day is enough to catch a broken release, and waiting longer leaves spotDL failing with 403",
      "matchPackageNames": [
        "yt-dlp"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "A database can't start on a new major's data, so these majors wait for a person even inside an app built here",
      "matchPackageNames": [
        "postgres",
        "rabbitmq"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "description": "A new Python for the gateway's images waits for a person: pikepdf and friends may have no wheels for it yet (3.15 broke the build, 2026-11-01). Patches and digests still merge",
      "matchPackageNames": [
        "python"
      ],
      "matchFileNames": [
        "compose/pdf-gateway/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false,
      "groupName": "pdf gateway python"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^compose/(clipseerr|subfeed|videodrop|songdrop|stanzarr|scanloom)/app/backend/requirements\\.txt$/",
      "/^compose/(musicguard|tv-remote)/requirements\\.txt$/",
      "/^compose/pdf-gateway/app/(archive-worker|paperless-adapter|signature-worker)/requirements\\.txt$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
