# Copy to /etc/batlab-restic/restic.env and edit there. Do not put passwords in
# this file or commit the live copy.
RESTIC_REPOSITORY=rclone:gdrive_personal:personal_server
RESTIC_PASSWORD_FILE=/etc/batlab-restic/restic-password
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RESTIC_CACHE_DIR=/var/cache/batlab-restic

# Snapshot retention.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=3

# Repository integrity check: one seventh per weekly run.
RESTIC_CHECK_SUBSET=1/7

# healthchecks.io ping URL of the restic-backup check. The backup reports its
# start and exit code, so a hung run alerts as well as a failed one.
RESTIC_HEALTHCHECK_URL=
