[Unit]
Description=Restore and validate critical files from the newest Restic snapshot
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/potato/batlab/restic/scripts/restore-test.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
