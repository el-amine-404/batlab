[Unit]
Description=Pull merged image bumps and recreate allow-listed Batlab services
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/home/potato/batlab/updater/scripts/update.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
