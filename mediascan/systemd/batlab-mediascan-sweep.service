[Unit]
Description=Sweep the Batlab media library for unexpected and unsafe files
Wants=network-online.target
After=network-online.target docker.service clamav-daemon.service
RequiresMountsFor=/mnt/storage/data

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/potato/batlab/mediascan/scripts/sweep.sh
# Exit 1 means findings were reported; exit 2 means the scan itself failed.
SuccessExitStatus=1
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
