[Unit]
Description=Watch the Batlab media tree and check files as they arrive
Wants=network-online.target
After=network-online.target docker.service
RequiresMountsFor=/mnt/storage/data
# The data disk can mount after boot has given up on it (2026-10-03: 13 minutes
# late), which fails this unit on its dependency with no retry. Being wanted by
# the mount starts it whenever the disk appears; BindsTo stops it if the disk goes.
BindsTo=mnt-storage-data.mount

[Service]
Type=simple
User=root
Group=root
ExecStart=/home/potato/batlab/mediascan/scripts/watch.sh
Restart=on-failure
RestartSec=30
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target mnt-storage-data.mount
