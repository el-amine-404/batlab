[Unit]
Description=Decode-verify new Batlab media and demux a slice of the library
Wants=network-online.target
After=network-online.target docker.service
RequiresMountsFor=/mnt/storage/data

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/potato/batlab/mediascan/scripts/deep.sh
Nice=19
IOSchedulingClass=idle
# Decoding is the only part of this suite that can hold every core at 100% for
# hours, which this chassis does not survive. Two cores leaves thermal headroom.
CPUQuota=200%

[Install]
WantedBy=multi-user.target
