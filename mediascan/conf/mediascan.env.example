# Copy to /etc/batlab-mediascan/mediascan.env and fill in the arr keys. The
# real file lives outside Git because it carries API keys.

MEDIASCAN_LIBRARY_ROOT=/mnt/storage/data
MEDIASCAN_QUARANTINE=/mnt/storage/data/.quarantine
MEDIASCAN_STATE_DIR=/var/lib/batlab-mediascan
MEDIASCAN_REPORT_DIR=/var/lib/batlab-mediascan/reports

# clamd's own MaxFileSize is 25M. Raising this only makes it skip more files
# silently, it does not make it inspect them.
MEDIASCAN_CLAMAV_MAX_SIZE=25M
MEDIASCAN_CLAMAV_INCREMENTAL=1

# qBittorrent's in-progress download artifacts. The quotes matter: this file is
# sourced, so an unquoted space starts a second command.
MEDIASCAN_IGNORE_SUFFIXES=".!qb .parts"

# Set to 1 to let the sweep move flagged files into quarantine instead of only
# reporting them.
MEDIASCAN_QUARANTINE_APPLY=0

# Fraction of the library the weekly deep pass demuxes, so a full rotation
# takes this many weeks.
MEDIASCAN_DEEP_FRACTION=4
MEDIASCAN_DEEP_SAMPLE_SECONDS=10

# Remediation is off unless deep-verify.sh is given --remediate. The arr
# containers mount MEDIASCAN_LIBRARY_ROOT at /data, so paths need translating.
MEDIASCAN_ARR_PATH_MAP="/mnt/storage/data=/data"
RADARR_URL=http://172.19.10.12:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_URL=http://172.19.10.11:8989
SONARR_API_KEY=your_sonarr_api_key_here
