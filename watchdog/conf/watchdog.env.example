# Copy to /etc/batlab-watchdog/watchdog.env and fill in the URLs there. The real
# file lives outside Git: anyone holding the ping URL can fake a healthy server,
# and anyone holding the webhook can post to the alerts channel.

# Leave empty on a host without the data disk: the heartbeat skips that check
# and the data guard must not be installed.
WATCHDOG_DATA_ROOT=/mnt/storage/data
WATCHDOG_SSH_PORT=22

# Set on a host serving the network's DNS: the heartbeat then asks this server
# for WATCHDOG_DNS_NAME and fails unless it gets an address back.
WATCHDOG_DNS_SERVER=
WATCHDOG_DNS_NAME=debian.org

# Seconds a self-test may run before it counts as hung.
WATCHDOG_CHECK_TIMEOUT=10

# Heartbeat failures (and recovery) are sent to Discord at these boundaries.
WATCHDOG_ROOT_DISK_PERCENT=85
WATCHDOG_BACKUP_MAX_AGE_HOURS=36
# The consistent dump of the database whose earlier permission failure could
# otherwise leave an apparently successful but incomplete snapshot.
WATCHDOG_BACKUP_FILE=/mnt/docker-volumes/database-dumps/sqlite/netalertx/db/app.db

# Failed data-disk reads in a row (one per 5-minute run) before the heartbeat
# has the data guard stop the data-disk containers of a disk that hangs while
# still mounted.
WATCHDOG_DISK_HUNG_AFTER=2

# The USB 2 side of the connector the data disk hangs on, as sysfs names it
# (lab2: usb1-port1, the peer of usb2-port1 where the disk enumerates at USB 3).
# revive-data-disk.sh power-cycles it to bring a disk back that dropped off.
WATCHDOG_DATA_USB_PORT=
# Require this disk to run at USB 2. A disk found at 5000M is stopped cleanly,
# moved to its USB 2 companion and mounted again before its containers resume.
WATCHDOG_FORCE_USB2=0
# USB 3 ports usb2-only.sh leaves enabled, space-separated (lab2: usb2-port2,
# the SSD's connector; the data disk's usb2-port1 stays at USB 2).
WATCHDOG_USB3_PORTS=
WATCHDOG_USB2_ATTEMPTS=3
# Let the disk back on at USB 3 when USB 2 gives nothing (1), or stay safely
# offline (0). Lab2 uses 0 because its JMS578 hangs under USB 3 sooner or later.
WATCHDOG_REVIVE_USB3_FALLBACK=0
# Minutes between tries once the disk is announced as needing a hand.
WATCHDOG_REVIVE_RETRY_MINUTES=10

# healthchecks.io ping URL of the lab1 check, e.g. https://hc-ping.com/<uuid>
WATCHDOG_HEALTHCHECK_URL=

# Messages go through Apprise (compose/apprise, the alerts channel); this
# webhook is for when Apprise can't be reached. The #alerts webhook, as Uptime
# Kuma's, is fine; messages carry their own sender name.
WATCHDOG_DISCORD_WEBHOOK=
