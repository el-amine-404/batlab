[Unit]
Description=Notify when the kernel kills a process for an out-of-memory condition
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/batlab-watchdog/watchdog.env
ExecStart=/home/potato/batlab/watchdog/scripts/oom_watch.py
StateDirectory=batlab-watchdog
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=no
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
