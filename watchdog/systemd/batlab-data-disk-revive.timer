[Unit]
Description=Check every two minutes that the data disk is back, and bring it back if not

[Timer]
OnBootSec=90s
# From each run's start, whether it succeeded or failed: OnUnitInactiveSec never
# fires again after a failed run, and a failed run is exactly when to retry.
OnUnitActiveSec=2min
Unit=batlab-data-disk-revive.service

[Install]
WantedBy=timers.target
