{
  auto_https off
  admin off
}
:8080 {
  root * /srv
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
  }
  @assets path /assets/* /icon.svg /icon-192.png /icon-512.png /manifest.webmanifest /sw.js
  header @assets Cache-Control "public, max-age=86400"
  route {
    @backend path /api/* /docs /api-docs/*
    reverse_proxy @backend {
      dynamic a {
        name api
        port 8850
        refresh 5s
        resolvers 127.0.0.11
      }
      flush_interval -1
    }
    try_files {path} /index.html
    file_server
  }
}
