# ----------------------------------------------------------------------------------------
# GOTENBERG
# ----------------------------------------------------------------------------------------
# No auth: paperless-ngx builds its GotenbergClient without an auth argument, so
# --api-enable-basic-auth would break office and eml conversion. Reachable on the
# lan through caddy and by paperless over the docker network.

GOTENBERG_API_TIMEOUT=120s

# ----------------------------------------------------------------------------------------
# PAPERLESS
# ----------------------------------------------------------------------------------------
# OCR_LANGUAGE is what tesseract runs by default, OCR_LANGUAGES installs the
# extra language packs at startup. Both are needed for non-english documents.

PAPERLESS_URL=http://paperless.homelab.lan
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=your_paperless_db_password_here
PAPERLESS_SECRET_KEY=your_paperless_secret_key_here
PAPERLESS_ADMIN_USER=your_paperless_admin_user_here
PAPERLESS_ADMIN_PASSWORD=your_paperless_admin_password_here

PAPERLESS_OCR_LANGUAGE=eng+fra+ara
PAPERLESS_OCR_LANGUAGES=eng fra ara

# ----------------------------------------------------------------------------------------
# AI / OLLAMA
# ----------------------------------------------------------------------------------------
# This host has no usable GPU and no AVX2, so inference is CPU bound and slow.
# MAX_LOADED_MODELS=1 in the compose file keeps only one model resident: the
# vision model alone needs about 6gb and the box has 15gb total.
#
# qwen3:4b        generation, metadata and document chat
# qwen2.5vl:7b    vision, used by paperless-gpt for llm ocr
# multilingual-e5-small   embeddings, the english-only default would break
#                         similar-document search on french and arabic

OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MEM_LIMIT=8gb

# Generate once with: openssl rand -hex 32
# Keep the value stable and never commit the real secret.
OPEN_WEBUI_SECRET_KEY=your_open_webui_secret_key_here

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_MODEL=qwen3:4b
PAPERLESS_AI_LLM_EMBEDDING_MODEL=intfloat/multilingual-e5-small
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=600
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=English

PAPERLESS_GPT_LLM_MODEL=qwen3:4b

# LLM based ocr is off: this host measured 1.09 tokens/sec on qwen3:4b, so a 7b
# vision model would need something like 10 to 25 minutes per page. Tesseract
# still does the ocr. To turn it on later, pull the model and set:
#   PAPERLESS_GPT_OCR_PROVIDER=llm
#   PAPERLESS_GPT_VISION_PROVIDER=ollama
#   PAPERLESS_GPT_VISION_MODEL=qwen2.5vl:7b
PAPERLESS_GPT_OCR_PROVIDER=
PAPERLESS_GPT_VISION_PROVIDER=
PAPERLESS_GPT_VISION_MODEL=
PAPERLESS_GPT_LANGUAGE=English
PAPERLESS_GPT_MANUAL_TAG=paperless-gpt
PAPERLESS_GPT_AUTO_TAG=paperless-gpt-auto
PAPERLESS_GPT_AUTO_OCR_TAG=paperless-gpt-ocr-auto

# ----------------------------------------------------------------------------------------
# GLUETUN / VPN
# ----------------------------------------------------------------------------------------
# ProtonVPN exit country. Must be one where Proton still runs working port
# forwarding servers: VPN_PORT_FORWARDING=on limits gluetun to that pool, and a
# dead pool leaves the tunnel looping with no error.
#
# Check a country before switching to it:
#   docker run --rm --cap-add NET_ADMIN --device /dev/net/tun \
#     --env-file compose/.env -e SERVER_COUNTRIES=<country> \
#     qmcgaw/gluetun:${TAG_GLUETUN} 2>&1 | grep -E "Public IP address|port forwarded"

GLUETUN_SERVER_COUNTRIES=Netherlands

# ----------------------------------------------------------------------------------------
# NAVIDROME
# ----------------------------------------------------------------------------------------
NAVIDROME_LASTFM_APIKEY=your_lastfm_api_key_here
NAVIDROME_LASTFM_SECRET=your_lastfm_secret_here

# ----------------------------------------------------------------------------------------
# HOMEPAGE WIDGET CREDENTIALS
# ----------------------------------------------------------------------------------------
# These drive dashboard widgets only. Empty values leave the tile showing an
# error until filled in; nothing else breaks.
#
# qBittorrent / AdGuard: the WebUI login you already use.
# Portainer: Settings -> Users -> your user -> Access tokens -> Add token.
# FileBrowser: the WebUI login.
# Navidrome uses Subsonic auth rather than a password:
#   SALT=$(openssl rand -hex 8)
#   TOKEN=$(printf '%s%s' '<your-password>' "$SALT" | md5sum | cut -d' ' -f1)

QBIT_USER=
QBIT_PASS=
ADGUARD_USER=
ADGUARD_PASS=
PORTAINER_API_KEY=
FILEBROWSER_USER=
FILEBROWSER_PASS=
NAVIDROME_USER=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
