# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# KEYS
# ----------------------------------------------------------------------------------------
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
JELLYFIN_API_KEY=your_jellyfin_api_key_here
IMMICH_API_KEY=your_immich_api_key_here
SEERR_API_KEY=your_seerr_api_key_here
# Discord, one webhook per channel. Every sender sets its own name, so several
# apps can share a channel's webhook.
# #alerts: something is down or failing
DISCORD_WEBHOOK_ALERTS=your_discord_webhook_url_here
# #updates: what the nightly updater deployed, and diun's new image notices
DISCORD_WEBHOOK_UPDATES=your_discord_webhook_url_here
# #requests: seerr, from request to available
DISCORD_WEBHOOK_REQUESTS=your_discord_webhook_url_here
# #downloads: sonarr and radarr imports and upgrades
DISCORD_WEBHOOK_DOWNLOADS=your_discord_webhook_url_here
# #download-issues: cleanuparr removals, import-audit, arr health warnings
DISCORD_WEBHOOK_DOWNLOAD_ISSUES=your_discord_webhook_url_here
# #cameras: Frigate's person-on-the-roof alerts, with the snapshot
DISCORD_WEBHOOK_CAMERAS=your_discord_webhook_url_here
# Apprise (compose/apprise) delivers batlab's own messages (songdrop,
# musicguard, camwatch, the updater, watchdog and other host scripts, Netdata,
# NetAlertX, Diun) per channel: NOTIFY_<CHANNEL> lists that channel's
# Apprise URLs, separated by spaces: Discord, Telegram (tgram://), ntfy
# (ntfy://), e-mail (mailto://)… (https://github.com/caronc/apprise/wiki).
# Unset, a channel uses its DISCORD_WEBHOOK_ above.
# NOTIFY_DOWNLOADS=tgram://bottoken/chatid
# NOTIFY_DOWNLOAD_ISSUES=ntfy://ntfy.sh/my-downloads
# NOTIFY_CAMERAS=
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
LIDARR_API_KEY=your_lidarr_api_key_here
READARR_API_KEY=your_readarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
BAZARR_API_KEY=your_bazarr_api_key_here
# Aurral's (Settings, General, API key): clipseerr hands it song requests.
# Read on clipseerr's first start only; after that, its Settings, Services.
AURRAL_API_KEY=
# videodrop's API keys (its Settings, API keys, or `docker exec videodrop python
# -m videodrop.admin add-key <name> --can …`): clipseerr's asks for downloads into
# destinations (--can download,destinations), Homepage's reads the counts
# (--can everyone). clipseerr takes its own at every start while it has none.
VIDEODROP_CLIPSEERR_KEY=
VIDEODROP_HOMEPAGE_KEY=
# subfeed's API keys (its Settings, API keys, or `docker exec subfeed python -m
# subfeed.admin add-key <name>`), each only reading: clipseerr's reads Hot's
# feed, Homepage's the status card.
SUBFEED_CLIPSEERR_KEY=
SUBFEED_HOMEPAGE_KEY=
# songdrop's API key for clipseerr (its Settings, API keys, or `docker exec
# songdrop python -m app.admin add-key clipseerr --can download`): clipseerr
# hands it songs. clipseerr takes it at every start while it has none.
SONGDROP_CLIPSEERR_KEY=
# clipseerr's first browsing country (YouTube) and Apple storefront; Settings, General after that.
# CLIPSEERR_REGION=US
# CLIPSEERR_STOREFRONT=us
# subtranslate (host timer): AI subtitles for languages no site has. A key from
# https://aistudio.google.com/apikey on a project without billing can't be charged.
GEMINI_API_KEY=
GEMINI_MODEL=
PAPERLESS_API_TOKEN=your_paperless_api_token_here

# ----------------------------------------------------------------------------------------
# GOTENBERG
# ----------------------------------------------------------------------------------------
# No auth: paperless-ngx builds its GotenbergClient without an auth argument, so
# --api-enable-basic-auth would break office and eml conversion. Reachable on the
# lan through caddy and by paperless over the docker network.

GOTENBERG_API_TIMEOUT=120s

# ----------------------------------------------------------------------------------------
# PAPERLESS
# ----------------------------------------------------------------------------------------
# OCR_LANGUAGE is what tesseract runs by default, OCR_LANGUAGES installs the
# extra language packs at startup. Both are needed for non-english documents.

PAPERLESS_URL=http://paperless.homelab.lan
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=your_paperless_db_password_here
PAPERLESS_SECRET_KEY=your_paperless_secret_key_here
PAPERLESS_ADMIN_USER=your_paperless_admin_user_here
PAPERLESS_ADMIN_PASSWORD=your_paperless_admin_password_here

PAPERLESS_OCR_LANGUAGE=eng+fra+ara
PAPERLESS_OCR_LANGUAGES="eng fra ara"

# ----------------------------------------------------------------------------------------
# AI / OLLAMA
# ----------------------------------------------------------------------------------------
# Model sizes, timeouts and resident-model limits depend on the machine; the
# values for lab1 and the reasons behind them are in hosts/lab1/README.md.
#
# qwen3:4b        generation, metadata and document chat
# qwen2.5vl:7b    vision, used by paperless-gpt for llm ocr
# multilingual-e5-small   embeddings, the english-only default would break
#                         similar-document search on french and arabic

OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=8192

# Generate once with: openssl rand -hex 32
# Keep the value stable and never commit the real secret.
OPEN_WEBUI_SECRET_KEY=your_open_webui_secret_key_here

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_MODEL=qwen3:4b
PAPERLESS_AI_LLM_EMBEDDING_MODEL=intfloat/multilingual-e5-small
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=600
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=English

PAPERLESS_GPT_LLM_MODEL=qwen3:4b

# LLM based ocr is off on lab1 (1.09 tokens/sec, see hosts/lab1/README.md);
# Tesseract still does the ocr. To turn it on, pull the model and set:
#   PAPERLESS_GPT_OCR_PROVIDER=llm
#   PAPERLESS_GPT_VISION_PROVIDER=ollama
#   PAPERLESS_GPT_VISION_MODEL=qwen2.5vl:7b
PAPERLESS_GPT_OCR_PROVIDER=
PAPERLESS_GPT_VISION_PROVIDER=
PAPERLESS_GPT_VISION_MODEL=
PAPERLESS_GPT_LANGUAGE=English
PAPERLESS_GPT_MANUAL_TAG=paperless-gpt
PAPERLESS_GPT_AUTO_TAG=paperless-gpt-auto
PAPERLESS_GPT_AUTO_OCR_TAG=paperless-gpt-ocr-auto

# ----------------------------------------------------------------------------------------
# GLUETUN / VPN
# ----------------------------------------------------------------------------------------
# ProtonVPN exit countries, comma-separated. Each must be one where Proton still
# runs working port forwarding servers: VPN_PORT_FORWARDING=on limits gluetun to
# that pool, and a dead pool leaves the tunnel looping with no error. Several
# countries give a reconnect more servers to land on: on 2026-10-03 the
# Netherlands pool (7 servers) kept refusing or dropping the port, while all
# seven below forwarded one within seconds. All are within 50 ms of lab2; see
# vpnguard/README.md for the measurements.
#
# Check a country before adding it. Stop the test container afterwards: it uses
# the same WireGuard key as the live tunnel, and two sessions on one key cost
# the live one half its packets and its forwarded port (2026-10-03, when a
# `timeout docker run` left seven of them running):
#   docker run -d --name vpntest --cap-add NET_ADMIN --device /dev/net/tun \
#     --env-file compose/.env -e SERVER_COUNTRIES=<country> qmcgaw/gluetun:${TAG_GLUETUN}
#   sleep 60; docker logs vpntest 2>&1 | grep -E "Public IP address|port forwarded"
#   docker rm -f vpntest

GLUETUN_SERVER_COUNTRIES="France,Switzerland,Spain,Portugal,United Kingdom,Germany,Belgium"

# Key for gluetun's control server route that changes the tunnel's state, used
# by vpnguard to reconnect. Generate: docker run --rm qmcgaw/gluetun genkey
# It also goes into ${VOLUMES_ROOT}/gluetun/auth/config.toml, made from
# compose/arr/conf/gluetun/auth.toml.example.
GLUETUN_CONTROL_API_KEY=

# ----------------------------------------------------------------------------------------
# NAVIDROME
# ----------------------------------------------------------------------------------------
NAVIDROME_LASTFM_APIKEY=your_lastfm_api_key_here
NAVIDROME_LASTFM_SECRET=your_lastfm_secret_here
# Navidrome accounts (docs/music.md), created with `navidrome user create`:
# musicguard starts scans once new music is checked; Aurral's reaches Navidrome
# through Caddy, which drops scan requests. Both are admins (Aurral needs it
# for its playlists). Enter Aurral's in Aurral's settings, URL http://caddy:4534.
NAVIDROME_MUSICGUARD_USER=musicguard
NAVIDROME_MUSICGUARD_PASSWORD=
NAVIDROME_AURRAL_USER=aurral
NAVIDROME_AURRAL_PASSWORD=

# Stanzarr (docs/music.md): the account, and the key AI-sync workers use.
STANZARR_SOURCE=/home/potato/stanzarr
STANZARR_USERNAME=admin
STANZARR_PASSWORD=
STANZARR_WORKER_KEY=

# ----------------------------------------------------------------------------------------
# MUSIC: SOULSEEK (docs/music.md)
# ----------------------------------------------------------------------------------------
# The Soulseek network account. There is no sign-up: the first login with an
# unused name creates it, so pick a name nobody has and keep the password.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
# slskd's own web UI login, and the API key Soularr and Aurral use
# (openssl rand -hex 24; slskd wants 16 to 255 characters).
SLSKD_WEB_USER=admin
SLSKD_WEB_PASS=
SLSKD_API_KEY=
# A second, read-only key for the Homepage widget. slskd takes only one key
# from the environment, so this one also goes in ${VOLUMES_ROOT}/slskd/slskd.yml
# under web.authentication.api_keys (docs/music.md).
SLSKD_HOMEPAGE_KEY=

# ----------------------------------------------------------------------------------------
# HOMEPAGE WIDGET CREDENTIALS
# ----------------------------------------------------------------------------------------
# These drive dashboard widgets only. Empty values leave the tile showing an
# error until filled in; nothing else breaks.
#
# qBittorrent / AdGuard: the WebUI login you already use. adguardhome-sync logs
# in to both AdGuard instances with the same AdGuard login.
# Portainer: Settings -> Users -> your user -> Access tokens -> Add token.
# FileBrowser: the WebUI login.
# Navidrome uses Subsonic auth rather than a password:
#   SALT=$(openssl rand -hex 8)
#   TOKEN=$(printf '%s%s' '<your-password>' "$SALT" | md5sum | cut -d' ' -f1)

QBIT_USER=
QBIT_PASS=
ADGUARD_USER=
ADGUARD_PASS=
PORTAINER_API_KEY=
FILEBROWSER_USER=
FILEBROWSER_PASS=
NAVIDROME_USER=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
# Dispatcharr: the WebUI and API login, created with manage.py createsuperuser
# (see docs/livetv.md).
DISPATCHARR_USER=
DISPATCHARR_PASS=
# NodeCast TV (docs/livetv.md): the app login, also Caddy's basic auth for
# nodecast.homelab.lan. NODECAST_PASS_HASH: caddy hash-password of NODECAST_PASS,
# in single quotes (bcrypt hashes contain $).
NODECAST_USER=admin
NODECAST_PASS=
NODECAST_PASS_HASH=''
NODECAST_JWT_SECRET=
# Dispatcharr Xtream Codes login NodeCast uses (custom property xc_password).
DISPATCHARR_XC_USER=nodecast
DISPATCHARR_XC_PASS=
# Frigate (docs/cameras.md): the Hikvision DVR it pulls the camera streams from.
# FRIGATE_RTSP_PASSWORD goes into an rtsp:// URL as is, so URL-encode reserved
# characters (@ -> %40, : -> %3A, / -> %2F, % -> %25, # -> %23, ? -> %3F).
# The DVR by name: AdGuard's static DHCP lease (hostname dvr, 192.168.1.2) makes
# dvr.lan, so a new address never needs a change here.
FRIGATE_DVR_HOST=dvr.lan
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=
