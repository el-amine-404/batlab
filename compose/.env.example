WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
JELLYFIN_API_KEY=your_jellyfin_api_key_here
IMMICH_API_KEY=your_immich_api_key_here
SEERR_API_KEY=your_seerr_api_key_here
DISCORD_WEBHOOK_DIUN=your_discord_webhook_url_here
DISCORD_WEBHOOK_ALERTS=your_discord_webhook_url_here
DISCORD_WEBHOOK_DOWNLOADS=your_discord_webhook_url_here
