# songdrop: paste a link, get the song (docs/music.md)
IMAGE_SPOTDL=spotdl/spotify-downloader
TAG_SPOTDL=v4.6.0
# songdrop's page is built with this Node (songdrop/app/Dockerfile).
IMAGE_SONGDROP_NODE=node
TAG_SONGDROP_NODE=24.22.1-alpine3.24
# spotDL's own yt-dlp falls behind YouTube; songdrop swaps in this one, and
# videodrop and clipseerr install it too.
PYPI_YTDLP=yt-dlp
VERSION_YTDLP=2026.10.26

# clipseerr: music videos to browse and ask for (compose/clipseerr/app/Dockerfile)
IMAGE_CLIPSEERR_BASE=python
TAG_CLIPSEERR_BASE=3.13.15-slim-trixie@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
# The cards' previews: yt-dlp answers YouTube's challenge with Deno (catalog/preview.py).
IMAGE_CLIPSEERR_DENO=denoland/deno
TAG_CLIPSEERR_DENO=2.9.7
IMAGE_CLIPSEERR_NODE=node
TAG_CLIPSEERR_NODE=24.22.1-alpine3.24
