# Image versions, one IMAGE_/TAG_ pair per image, grouped by stack.
# Renovate reads and bumps these pairs (see renovate.json), so keep each TAG_
# line directly below its IMAGE_ line. Pin exact tags; Renovate does the rest.
# Verify registry tags before editing by hand: the registry tag is not always
# the GitHub release tag. PYPI_/VERSION_ and CRATE_/VERSION_ pairs are the same
# for a Python package or Rust crate a locally built image installs.

# (unused)
IMAGE_BEETS=lscr.io/linuxserver/beets
TAG_BEETS=2.5.1
IMAGE_LANGUAGETOOL=meyay/languagetool
TAG_LANGUAGETOOL=6.8-3
