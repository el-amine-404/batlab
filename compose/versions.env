# spotDL's own yt-dlp falls behind YouTube; songdrop swaps in this one.
PYPI_YTDLP=yt-dlp
VERSION_YTDLP=2026.8.19

# musicguard: the Python base image of the locally built guard (its Dockerfile)
IMAGE_MUSICGUARD_BASE=python
TAG_MUSICGUARD_BASE=3.13.15-slim-trixie@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
IMAGE_MUSICGUARD_RUST=rust
TAG_MUSICGUARD_RUST=1.98.1-slim-trixie
# SongRec (Shazam client) that the musicguard image compiles.
CRATE_SONGREC=songrec
VERSION_SONGREC=0.7.4

