{
	# do not attempt to install certs on the docker container
	skip_install_trust
}

# Only the home network: anyone else has the connection closed. Without the
# abort, a request the reverse_proxy matcher skipped got an empty 200.
(localSubnets) {
	@localSubnets remote_ip private_ranges
	@outside not remote_ip private_ranges
	abort @outside
}

import *.caddy

# A name no service answers to (a removed service, a typo): DNS sends every
# *.homelab.lan here, and without this Caddy answered an empty page with 200.
# Caddy tries exact names before a wildcard, so the sites above are unaffected.
http://*.homelab.lan {
	respond "No service at this address." 404
}

# Any other name (a bare IP, a made-up Host header) used to get an empty 200.
http:// {
	abort
}
