# Same-origin web UI: static files plus a reverse proxy to the API, so session
# cookies stay SameSite=Strict and host-only. TLS terminates at the existing
# homelab Caddy in front of this container.
{
	admin off
	auto_https off
	persist_config off
	# Keep the scheme and host the homelab Caddy saw (HTTPS): the API compares a
	# browser's Origin with them. Only private addresses can reach this container.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	handle /api/* {
		# The API sets its own headers (downloads are sandboxed attachments).
		reverse_proxy {$PDF_GATEWAY_API_UPSTREAM:api:8080} {
			flush_interval -1
		}
	}

	handle {
		# Static files only: compressing API responses would rewrite ETags (breaking
		# If-Match) and compress CSRF tokens beside reflected data (BREACH).
		encode zstd gzip
		root * /srv
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy same-origin
			X-Frame-Options DENY
			-Server
		}
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
