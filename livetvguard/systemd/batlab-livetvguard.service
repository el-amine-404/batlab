[Unit]
Description=Close Jellyfin live TV streams nobody watches
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/usr/bin/python3 /home/potato/batlab/livetvguard/scripts/livetvguard.py
TimeoutStartSec=5m
