[Unit]
Description=Reconnect gluetun when Proton stops forwarding a port
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/usr/bin/python3 /home/potato/batlab/vpnguard/scripts/vpnguard.py
TimeoutStartSec=5m
