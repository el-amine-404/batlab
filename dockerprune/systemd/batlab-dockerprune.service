[Unit]
Description=Remove old Docker images, build cache and stray containers
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/usr/bin/python3 /home/potato/batlab/dockerprune/scripts/dockerprune.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
