[Unit]
Description=Remove dated backup folders past their retention
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/usr/bin/python3 /home/potato/batlab/backupprune/scripts/backupprune.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
