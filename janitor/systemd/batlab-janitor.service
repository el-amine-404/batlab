[Unit]
Description=Remove old images, build cache and stray containers from the root disk
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=potato
Group=potato
WorkingDirectory=/home/potato/batlab
ExecStart=/usr/bin/python3 /home/potato/batlab/janitor/scripts/janitor.py clean
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
